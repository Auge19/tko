{
  "version": "4.0.0-beta1.6",
  "name": "@tko/builder",
  "description": "Compile a customized instance of Knockout.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knockout/tko.git"
  },
  "author": "The Knockout Team",
  "license": "MIT",
  "dependencies": {
    "@tko/bind": "*",
    "@tko/computed": "*",
    "@tko/filter.punches": "*",
    "@tko/lifecycle": "*",
    "@tko/observable": "*",
    "@tko/utils": "*",
    "@tko/utils.parser": "*",
    "tslib": "^2.2.0"
  },
  "homepage": "https://tko.io",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "@tko/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./helpers/*": "./helpers/*"
  },
  "karma": {
    "frameworks": [
      "mocha"
    ]
  },
  "bugs": {
    "url": "https://github.com/knockout/tko/issues"
  }
}
