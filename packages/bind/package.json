{
  "name": "@tko/bind",
  "version": "4.0.0-beta1.3",
  "type": "module",
  "description": "TKO DOM-Observable Binding",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@tko/computed": "*",
    "@tko/lifecycle": "*",
    "@tko/observable": "*",
    "@tko/provider": "*",
    "@tko/utils": "*",
    "tslib": "^2.2.0"
  },
  "peerDependencies": {
    "@tko/binding.foreach": "^4.0.0-alpha9.0"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knockout/tko.git"
  },
  "author": "The Knockout Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/knockout/tko/issues"
  },
  "homepage": "https://tko.io",
  "karma": {
    "frameworks": [
      "jasmine"
    ]
  },
  "__about__": "These are copied into all packages/*/package.json",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "exports": {
    ".": {
      "@tko/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./helpers/*": "./helpers/*"
  }
}
